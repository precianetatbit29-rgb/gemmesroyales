<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Gemmes Royales - Jeu Match 3</title>
<meta name="description" content="Gemmes Royales : un jeu de match-3 gratuit. Alignez 3 gemmes ou plus, atteignez l'objectif et passez au niveau suivant !">
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7251522297410896" crossorigin="anonymous"></script>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{margin:0;height:100%}
body{font-family:system-ui,Segoe UI,Roboto,sans-serif;color:#fff;background:linear-gradient(180deg,#2a0a5e,#7b2ff7,#ff2e88);display:flex;flex-direction:column;align-items:center;padding:10px 8px 0;overflow-x:hidden}
body::before{content:"✨💎👑✨💎👑✨💎👑";position:fixed;top:0;left:0;right:0;text-align:center;opacity:.25;font-size:18px;pointer-events:none;animation:float 3s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}
h1{font-size:26px;margin:4px 0 8px;letter-spacing:1px;text-shadow:0 3px 0 #ff2e88,0 6px 20px #0008;animation:float 2.5s ease-in-out infinite}
h1 span{color:#ffd54a}
#hud{width:min(94vw,480px);display:flex;gap:8px;margin-bottom:8px}
.box{flex:1;background:#fff;color:#2a0a5e;border-radius:14px;padding:6px 8px;text-align:center;box-shadow:0 4px 12px #0004}
.box small{display:block;font-size:11px;opacity:.7;text-transform:uppercase;font-weight:700}
.box b{font-size:20px;color:#ff2e88}
#barwrap{width:min(94vw,480px);height:14px;background:#0005;border-radius:20px;overflow:hidden;margin-bottom:10px}
#bar{height:100%;width:0;background:linear-gradient(90deg,#ffd700,#ff2e88,#00e5ff);transition:width .4s}
#board{position:relative;width:min(94vw,480px);aspect-ratio:1;background:#fff2;border-radius:18px;border:2px solid #ffffff60;touch-action:none;overflow:hidden;box-shadow:0 10px 30px #0005}
.tile{position:absolute;left:0;top:0;transition:transform .3s ease-in,opacity .25s,scale .25s;animation:shine 2s infinite}
@keyframes shine{0%,100%{filter:brightness(1)}50%{filter:brightness(1.25)}}
.tile::before{content:"";position:absolute;inset:10%;background:radial-gradient(circle at 30% 25%,rgba(255,255,255,.8),transparent 35%),var(--c);clip-path:var(--shape);filter:drop-shadow(0 3px 3px #0008)}
.tile.sel{scale:1.15;z-index:2;filter:drop-shadow(0 0 10px #ffd700)}
.tile.pop{opacity:0;scale:1.6}
.t0{--c:#ef4444;--shape:circle(46%)}
.t1{--c:#3b82f6;--shape:polygon(50% 0,100% 50%,50% 100%,0 50%)}
.t2{--c:#22c55e;--shape:polygon(25% 3%,75% 3%,100% 50%,75% 97%,25% 97%,0 50%)}
.t3{--c:#facc15;--shape:polygon(50% 0,62% 36%,100% 38%,70% 60%,80% 98%,50% 76%,20% 98%,30% 60%,0 38%,38% 36%)}
.t4{--c:#a855f7;--shape:inset(4% round 28%)}
.t5{--c:#fb923c;--shape:polygon(50% 4%,98% 92%,2% 92%)}
#msg{height:28px;margin:6px 0;font-size:20px;font-weight:900;color:#ffd54a;text-shadow:0 2px 8px #000;text-align:center}
#msg.pop{animation:pop .5s}
@keyframes pop{0%{transform:scale(.5)}50%{transform:scale(1.3) rotate(-2deg)}100%{transform:scale(1)}}
#comboPop{position:fixed;top:42%;left:50%;transform:translate(-50%,-50%);font-size:38px;font-weight:900;text-shadow:0 4px 0 #ff2e88,0 10px 20px #0008;z-index:99;display:none;pointer-events:none;text-align:center}
#comboPop.show{display:block;animation:pop .6s}
.confetti{position:fixed;top:-10px;width:10px;height:14px;z-index:98;pointer-events:none;animation:fall 2s forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:0}}
#adbottom{width:min(94vw,480px);min-height:60px;margin-top:auto;padding-bottom:6px}
#overlay{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;z-index:10;padding:16px}
#modal{background:linear-gradient(#4b32b0,#2a1a73);border:2px solid #ffd54a;border-radius:18px;padding:20px;width:min(92vw,360px);text-align:center;max-height:95vh;overflow:auto}
#modal h2{margin:0 0 8px;color:#ffd54a}
#modal p{margin:0 0 12px}
#modal button{background:linear-gradient(#ffd54a,#ff9f1c);border:0;border-radius:24px;padding:12px 28px;font-size:17px;font-weight:700;color:#3a2200;cursor:pointer}
#soundBtn{width:min(94vw,480px);background:#ffd700;color:#2a0a5e;border:0;border-radius:999px;padding:10px;font-weight:900;margin:6px 0;cursor:pointer}
#modalad{margin:12px 0;min-height:100px}
footer{font-size:11px;opacity:.7;padding:4px 0 8px}
footer a{color:#fff}
</style>
</head>
<body>
<h1>💎 Gemmes <span>Royales</span> 👑</h1>
<div id="hud">
  <div class="box"><small>Niveau</small><b id="lvl">1</b></div>
  <div class="box"><small>Score / Objectif</small><b id="score">0</b><span id="goal" style="font-size:12px;opacity:.8"></span></div>
  <div class="box"><small>Coups</small><b id="moves">0</b></div>
  <div class="box"><small>Record</small><b id="best">0</b></div>
</div>
<div id="barwrap"><div id="bar"></div></div>
<div id="board"></div>
<div id="msg">À toi de jouer ! 💖</div>
<button id="soundBtn" onclick="toggleSound()">🔊 Son : ON - Clique pour couper</button>
<div id="comboPop"></div>
<div id="adbottom">
  <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7251522297410896" data-ad-slot="1111111111" data-ad-format="auto" data-full-width-responsive="true"></ins>
</div>
<footer><a href="privacy.html">Politique de confidentialité</a></footer>
<div id="overlay"><div id="modal">
  <h2 id="mt"></h2><p id="mp"></p>
  <div id="modalad"></div>
  <button id="mb"></button>
</div></div>
<script>
try{(window.adsbygoogle=window.adsbygoogle||[]).push({});}catch(e){}
const $=id=>document.getElementById(id);
const N=8,T=6,sleep=ms=>new Promise(r=>setTimeout(r,ms));
const boardEl=$('board');
let size=0,board=[],score=0,moves=0,level=1,goal=0,busy=false,sel=null,start=null,best=0;
let soundOn=true,audioCtx=null;
function initAudio(){if(!audioCtx)audioCtx=new (window.AudioContext||window.webkitAudioContext)();}
function beep(f,d,type='sine',v=0.2){if(!soundOn)return;try{initAudio();let o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);o.type=type;o.frequency.value=f;g.gain.value=v;o.start();o.stop(audioCtx.currentTime+d);}catch(e){}}
function sClick(){beep(600,0.08,'sine',0.15);}
function sMatch(){beep(800,0.12,'sine',0.2);setTimeout(()=>beep(1000,0.15,'sine',0.2),80);setTimeout(()=>beep(1300,0.2,'triangle',0.25),160);}
function sCombo(){beep(1200,0.1,'square',0.12);setTimeout(()=>beep(1500,0.15,'square',0.12),70);}
function sWin(){[523,659,784,1046].forEach((f,i)=>setTimeout(()=>beep(f,0.25,'triangle',0.3),i*120));}
function sBad(){beep(200,0.2,'sawtooth',0.1);}
function toggleSound(){soundOn=!soundOn;$('soundBtn').textContent=soundOn?'🔊 Son : ON - Clique pour couper':'🔇 Son : OFF - Clique pour activer';if(soundOn)sClick();}
function showCombo(t){let c=$('comboPop');c.textContent=t;c.classList.add('show');setTimeout(()=>c.classList.remove('show'),900);}
function confetti(){let cols=['#ffd700','#ff2e88','#00e5ff','#2eff7a','#b04bff'];for(let i=0;i<35;i++){let e=document.createElement('div');e.className='confetti';e.style.left=Math.random()*100+'%';e.style.background=cols[i%5];e.style.animationDelay=(Math.random()*0.5)+'s';document.body.appendChild(e);setTimeout(()=>e.remove(),2500);}}
try{best=+localStorage.getItem('gr_best')||0}catch(e){}
const rnd=()=>Math.floor(Math.random()*T);
function place(t){t.el.style.transform='translate('+t.c*size+'px,'+t.r*size+'px)';}
function mk(type,r,c){const el=document.createElement('div');el.className='tile t'+type;el.style.width=el.style.height=size+'px';boardEl.appendChild(el);const t={type,el,r,c};place(t);return t;}
function layout(){size=boardEl.clientWidth/N;board.forEach(row=>row.forEach(t=>{if(t){t.el.style.width=t.el.style.height=size+'px';place(t);}}));}
addEventListener('resize',layout);
function hud(){$('lvl').textContent=level;$('score').textContent=score;$('goal').textContent=' / '+goal;$('moves').textContent=moves;$('best').textContent=best;$('bar').style.width=Math.min(100,score/goal*100)+'%';}
function say(t){let m=$('msg');m.textContent=t;m.classList.remove('pop');void m.offsetWidth;m.classList.add('pop');if(t)setTimeout(()=>{if(m.textContent===t)m.textContent=''},1800);}
function findMatches(){const s=new Set();for(let r=0;r<N;r++){let run=1;for(let c=1;c<=N;c++){if(c<N&&board[r][c]&&board[r][c-1]&&board[r][c].type===board[r][c-1].type)run++;else{if(run>=3)for(let k=1;k<=run;k++)s.add(board[r][c-k]);run=1;}}}for(let c=0;c<N;c++){let run=1;for(let r=1;r<=N;r++){if(r<N&&board[r][c]&&board[r-1][c]&&board[r][c].type===board[r-1][c].type)run++;else{if(run>=3)for(let k=1;k<=run;k++)s.add(board[r-k][c]);run=1;}}}return s;}
function hasMove(){for(let r=0;r<N;r++)for(let c=0;c<N;c++){for(const [dr,dc] of [[0,1],[1,0]]){const r2=r+dr,c2=c+dc;if(r2>=N||c2>=N)continue;const a=board[r][c],b=board[r2][c2];board[r][c]=b;board[r2][c2]=a;const ok=findMatches().size>0;board[r][c]=a;board[r2][c2]=b;if(ok)return true;}}return false;}
function reshuffle(){let g=0;do{board.forEach(row=>row.forEach(t=>{t.type=rnd();t.el.className='tile t'+t.type;}));g++;}while((findMatches().size||!hasMove())&&g<300);}
function swapT(a,b){board[a.r][a.c]=b;board[b.r][b.c]=a;[a.r,b.r]=[b.r,a.r];[a.c,b.c]=[b.c,a.c];place(a);place(b);}
function gravity(){for(let c=0;c<N;c++){let w=N-1;for(let r=N-1;r>=0;r--){const t=board[r][c];if(t){if(r!==w){board[w][c]=t;board[r][c]=null;t.r=w;place(t);}w--;}}const news=[];for(let r=w;r>=0;r--){const t=mk(rnd(),r-(w+1),c);board[r][c]=t;news.push([t,r]);}void boardEl.offsetWidth;news.forEach(([t,r])=>{t.r=r;place(t);});}}
async function resolve(){let chain=0;while(true){const m=findMatches();if(!m.size)break;chain++;let pts=m.size*10*chain+(m.size>3?(m.size-3)*20:0);score+=pts;if(chain>1){sCombo();say('COMBO x'+chain+' ! 🔥 +'+pts);showCombo('COMBO x'+chain+' ! 🔥');confetti();}else if(m.size>=5){say('INCROYABLE ! +'+pts+' 🤩');showCombo('INCROYABLE ! 🤩');confetti();sMatch();}else if(m.size>=4){say('GÉNIAL ! +'+pts+' ✨');showCombo('GÉNIAL ! ✨');sMatch();}else{say('SUPER ! +'+pts+' 🎉');sMatch();}m.forEach(t=>{t.el.classList.add('pop');board[t.r][t.c]=null;});hud();await sleep(260);m.forEach(t=>t.el.remove());gravity();await sleep(380);}}
async function trySwap(a,b){if(busy)return;busy=true;clearSel();sClick();swapT(a,b);await sleep(230);if(!findMatches().size){sBad();swapT(a,b);await sleep(230);busy=false;return;}moves--;hud();await resolve();afterMove();}
function afterMove(){if(score>=goal){win();return;}if(moves<=0){lose();return;}if(!hasMove()){say('Pas de coup possible : mélange !');reshuffle();}busy=false;}
function showOverlay(title,text,btn,fn){$('mt').textContent=title;$('mp').textContent=text;$('mb').textContent=btn;$('mb').onclick=()=>{$('overlay').style.display='none';fn();};const ad=$('modalad');ad.innerHTML='<ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-7251522297410896" data-ad-slot="2222222222" data-ad-format="auto" data-full-width-responsive="true"></ins>';try{(window.adsbygoogle=window.adsbygoogle||[]).push({});}catch(e){}$('overlay').style.display='flex';}
function saveBest(){if(score>best){best=score;try{localStorage.setItem('gr_best',best)}catch(e){}}hud();}
function win(){sWin();confetti();confetti();saveBest();showOverlay('🎉 Niveau '+level+' réussi !','Score : '+score+' • Coups restants : '+moves,'Niveau suivant',()=>startLevel(level+1));}
function lose(){sBad();saveBest();showOverlay('Plus de coups','Score : '+score+' / objectif '+goal,'Rejouer',()=>startLevel(level));}
function startLevel(l){level=l;score=0;moves=20+Math.min(l,10);goal=500+l*300;boardEl.innerHTML='';board=[];size=boardEl.clientWidth/N;for(let r=0;r<N;r++){board[r]=[];for(let c=0;c<N;c++)board[r][c]=mk(rnd(),r,c);}reshuffle();hud();busy=false;sel=null;start=null;say('Niveau '+l+' ! À toi de jouer 💖');}
function tileAt(e){const rect=boardEl.getBoundingClientRect();const c=Math.floor((e.clientX-rect.left)/size),r=Math.floor((e.clientY-rect.top)/size);return (r>=0&&r<N&&c>=0&&c<N)?board[r][c]:null;}
function clearSel(){if(sel){sel.el.classList.remove('sel');sel=null;}}
const adj=(a,b)=>Math.abs(a.r-b.r)+Math.abs(a.c-b.c)===1;
boardEl.addEventListener('pointerdown',e=>{if(busy)return;const t=tileAt(e);if(!t)return;if(sel&&sel!==t&&adj(sel,t)){const s=sel;trySwap(s,t);return;}clearSel();sel=t;t.el.classList.add('sel');start={x:e.clientX,y:e.clientY,t};});
boardEl.addEventListener('pointermove',e=>{if(!start||busy)return;const dx=e.clientX-start.x,dy=e.clientY-start.y;if(Math.max(Math.abs(dx),Math.abs(dy))<size*0.4)return;let r=start.t.r,c=start.t.c;if(Math.abs(dx)>Math.abs(dy))c+=dx>0?1:-1;else r+=dy>0?1:-1;const a=start.t;start=null;if(r<0||r>=N||c<0||c>=N)return;trySwap(a,board[r][c]);});
addEventListener('pointerup',()=>{start=null;});
startLevel(1);
if('serviceWorker' in navigator){navigator.serviceWorker.register('sw.js');}
</script>
</body>
</html>
